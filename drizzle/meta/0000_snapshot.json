  "views": {
    "public.v_course_item_progress": {
      "columns": {
        "course_id": {
          "name": "course_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "item_id": {
          "name": "item_id",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "section_id": {
          "name": "section_id",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "required_count": {
          "name": "required_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "approved_count": {
          "name": "approved_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "pending_count": {
          "name": "pending_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  SELECT\n    c.id                                   AS course_id,\n    ri.id                                  AS item_id,\n    ri.section_id,\n    ri.required_count,\n    COUNT(*) FILTER (WHERE sr.status = 'APPROVED')                  AS approved_count,\n    COUNT(*) FILTER (WHERE sr.status IN ('PENDING', 'DRAFT'))       AS pending_count\n  FROM courses c\n  CROSS JOIN requirement_items ri\n  LEFT JOIN signoff_requests sr\n         ON sr.course_id = c.id AND sr.item_id = ri.id\n  WHERE ri.is_active\n  GROUP BY c.id, ri.id\n",
      "name": "v_course_item_progress",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.v_course_progress": {
      "columns": {
        "course_id": {
          "name": "course_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "total_units": {
          "name": "total_units",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "approved_units": {
          "name": "approved_units",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "pending_units": {
          "name": "pending_units",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "not_started_units": {
          "name": "not_started_units",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "percent_complete": {
          "name": "percent_complete",
          "type": "numeric",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  SELECT\n    course_id,\n    SUM(required_count)                                          AS total_units,\n    SUM(LEAST(approved_count, required_count))                   AS approved_units,\n    SUM(LEAST(pending_count, GREATEST(required_count - approved_count, 0))) AS pending_units,\n    SUM(required_count) - SUM(LEAST(approved_count, required_count))\n      - SUM(LEAST(pending_count, GREATEST(required_count - approved_count, 0)))  AS not_started_units,\n    ROUND(100.0 * SUM(LEAST(approved_count, required_count)) / NULLIF(SUM(required_count), 0), 1) AS percent_complete\n  FROM v_course_item_progress\n  GROUP BY course_id\n",
      "name": "v_course_progress",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
